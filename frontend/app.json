      },
      "edgeToEdgeEnabled": true,
      "package": "com.mouneesh_d.CRVotingApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f140ada8-41d3-454c-b135-84c6c135baaa"
      },
      "apiUrl": "https://class-representative-app.onrender.com/api"
